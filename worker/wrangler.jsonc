{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "escape-crystal-pr",
  "main": "index.mjs",
  "compatibility_date": "2026-09-05",
  "routes": [{ "pattern": "crystal-pr.emmi.sh", "custom_domain": true }],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5174",
    "BASE_BRANCH": "master",
    "DEPLOYMENT_MODE": "production",
    "PR_ENABLED": "true"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "escape-crystal-pr", "database_id": "050d485b-2815-4500-bb63-c82c072c59bd", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["17 * * * *"] }
}
